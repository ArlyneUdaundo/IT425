DJANGO_SECRET_KEY=replace-this-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# On Render, set DATABASE_URL to the PostgreSQL database's internal URL.
PGDATABASE=student_records
PGUSER=postgres
PGPASSWORD=your-postgres-password
PGHOST=127.0.0.1
PGPORT=5432
